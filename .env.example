# ==============================================================================
# Cyberfeed Environment Variables Template
# Copy this file to '.env' and fill in your actual private credentials.
# NEVER commit the actual '.env' file to your version control repository.
# ==============================================================================

# --- System Configuration ---
# Options: development, staging, production
APP_ENV=development
APP_PORT=9850
APP_LOG_LEVEL=debug

# --- Security & Authentication ---
# Generate a secure 32-byte or 64-byte secret key for session/JWT signing
APP_SECRET_KEY=your_super_secret_64_character_random_string_here
API_KEY_FREE_CREDITS=your_free_ai_agent_api_key_here

# --- Database Credentials ---
# Local MongoDB connection URI pattern
DATABASE_URL=mongodb://root:password@localhost:27017/cyberfeed?authSource=admin

# --- External Telemetry & Tracking ---
# Ports for tracking background operational telemetry loops
MONITOR_CADDY_PORT=2019
MONITOR_TRAEFIK_PORT=8085
MONITOR_DOCKER_SOCKET=/var/run/docker.sock

